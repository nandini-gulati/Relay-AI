# ==============================================================================
# Relay Environment Configuration Template
# NOTE: Replace placeholder values below with your actual API keys.
# Never commit real API keys to version control.
# ==============================================================================

# Comma-separated LLM API key pool (at least 2 keys for failover)
# Key ids assigned in sequential order: key_1, key_2, ...
LLM_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# LiteLLM model identifier (default: gemini/gemini-2.5-flash-lite)
LLM_MODEL=gemini/gemini-2.5-flash-lite

# SQLite database path (use sqlite:////data/app.db for Docker volume persistence)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable failover test hook (X-Simulate-Failure request header)
ENABLE_FAILURE_SIMULATION=true

# Optional default system prompt for new chat sessions
DEFAULT_SYSTEM_PROMPT=You are Relay, an intelligent, helpful, and transparent AI assistant.
